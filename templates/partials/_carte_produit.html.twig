{# Carte produit réutilisée sur la page d'accueil et la page catalogue.
   Variables attendues :
   - produit (entité App\Entity\Produit)
   - badge (texte optionnel, ex: "Le plus populaire") #}
<div class="col-md-6 col-lg-4 produit-card-col" data-categorie="{{ produit.categorie.id }}">
    <div class="produit-card">
        {% if badge is defined and badge %}
            <span class="produit-card__badge">{{ badge }}</span>
        {% endif %}

        <a href="{{ path('app_produit_detail', { id: produit.id }) }}">
            <img src="{{ produit.imagePrincipale ? asset('images/produits/' ~ produit.imagePrincipale) : asset('images/placeholder-produit.svg') }}"
                 alt="{{ produit.nom }}" class="produit-card__image">
        </a>

        <div class="produit-card__body">
            <span class="produit-card__categorie">{{ produit.categorie.nom }}</span>
            <h3><a href="{{ path('app_produit_detail', { id: produit.id }) }}" class="produit-card__titre-lien">{{ produit.nom }}</a></h3>
            {% if produit.sousTitre or produit.resolution %}
                <p class="produit-card__sous-titre">{{ produit.sousTitre ?: 'Caméra ' ~ produit.resolution }}</p>
            {% endif %}

            <ul class="produit-card__specs">
                {% if produit.pointsForts %}
                    {% for point in produit.pointsFortsListe %}
                        <li><i class="bi bi-check-circle-fill"></i> {{ point }}</li>
                    {% endfor %}
                {% else %}
                    {% if produit.autonomie %}<li><i class="bi bi-check-circle-fill"></i> Autonomie : {{ produit.autonomie }}</li>{% endif %}
                    {% if produit.stockage %}<li><i class="bi bi-check-circle-fill"></i> Stockage : {{ produit.stockage }}</li>{% endif %}
                    <li><i class="bi bi-check-circle-fill"></i> Alimentation : {{ produit.alimentation }}</li>
                    <li><i class="bi bi-check-circle-fill"></i> Application mobile incluse</li>
                {% endif %}
            </ul>

            <div class="produit-card__footer">
                <div class="produit-card__prix">{{ produit.prix|number_format(0, ',', ' ') }} €</div>
                <span class="produit-card__prix-note">Installation + configuration incluses</span>

                <a href="https://wa.me/{{ whatsapp_number }}?text={{ ('Bonjour, je souhaite installer le modèle "' ~ produit.nom ~ '"')|url_encode }}"
                   target="_blank" rel="noopener" class="btn-pill btn-pill--block">
                    Choisir cette offre <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>
