{# Carte produit réutilisée sur la page d'accueil et la page catalogue.
   Variables attendues :
   - produit (entité App\Entity\Produit)
   - badge (texte optionnel, déjà traduit par l'appelant, ex: "Le plus populaire") #}
<div class="col-md-6 col-lg-4 produit-card-col" data-categorie="{{ produit.categorie.id }}">
    <div class="produit-card">
        {% if produit.aVenir %}
            <span class="produit-card__badge produit-card__badge--venir">{% trans %}Produit à venir{% endtrans %}</span>
        {% elseif badge is defined and badge %}
            <span class="produit-card__badge">{{ badge }}</span>
        {% endif %}

        <a href="{{ path('app_produit_detail', { id: produit.id }) }}">
            <img src="{{ produit.imagePrincipale ? asset('images/produits/' ~ produit.imagePrincipale) : asset('images/placeholder-produit.svg') }}"
                 alt="{{ produit.nom }}" class="produit-card__image" loading="lazy">
        </a>

        <div class="produit-card__body">
            <span class="produit-card__categorie">{{ produit.categorie.nom }}</span>
            <h3><a href="{{ path('app_produit_detail', { id: produit.id }) }}" class="produit-card__titre-lien">{{ produit.nom }}</a></h3>
            {% if produit.sousTitre or produit.resolution %}
                <p class="produit-card__sous-titre">{{ produit.sousTitre ?: (('Caméra %res%')|trans({'%res%': produit.resolution})) }}</p>
            {% endif %}

            <ul class="produit-card__specs">
                {% if produit.pointsForts %}
                    {% for point in produit.pointsFortsListe %}
                        <li><i class="bi bi-check-circle-fill"></i> {{ point }}</li>
                    {% endfor %}
                {% else %}
                    {% if produit.autonomie %}<li><i class="bi bi-check-circle-fill"></i> {{ ('Autonomie : %value%')|trans({'%value%': produit.autonomie}) }}</li>{% endif %}
                    {% if produit.stockage %}<li><i class="bi bi-check-circle-fill"></i> {{ ('Stockage : %value%')|trans({'%value%': produit.stockage}) }}</li>{% endif %}
                    <li><i class="bi bi-check-circle-fill"></i> {{ ('Alimentation : %value%')|trans({'%value%': produit.alimentation}) }}</li>
                    <li><i class="bi bi-check-circle-fill"></i> {% trans %}Application mobile incluse{% endtrans %}</li>
                {% endif %}
            </ul>

            <div class="produit-card__footer">
                <div class="produit-card__prix">{{ produit.prix|number_format(0, ',', ' ') }} €</div>
                <span class="produit-card__prix-note">{% trans %}Installation + configuration incluses{% endtrans %}</span>

                <a href="https://wa.me/{{ whatsapp_number }}?text={{ (('Bonjour, je souhaite installer le modèle "%nom%"')|trans({'%nom%': produit.nom}))|url_encode }}"
                   target="_blank" rel="noopener" class="btn-pill btn-pill--block">
                    {% trans %}Choisir cette offre{% endtrans %} <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>
