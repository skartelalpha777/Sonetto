<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ entreprise_nom }} — Sonnettes vidéo connectées à Bruxelles{% endblock %}</title>
    <meta name="description" content="{% block meta_description %}Vente, installation et configuration de sonnettes vidéo connectées à Bruxelles. Payez seulement après installation.{% endblock %}">
    <link rel="icon" href="{{ asset('images/logo.svg') }}">

    {# Bootstrap : uniquement pour la grille/flexbox (container, row, col-*, d-flex...) #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {# Notre design (couleurs, cartes, navbar, footer, hero...) #}
    <link href="{{ asset('css/style.css') }}" rel="stylesheet">

    {% block stylesheets %}{% endblock %}
</head>
<body>

{# ==================== NAVBAR (identique sur toutes les pages) ==================== #}
<nav class="navbar navbar-expand-lg navbar-sonetto sticky-top">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('app_accueil') }}">
            <img src="{{ asset('images/logo.svg') }}" alt="{{ entreprise_nom }}" height="34">
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSonetto"
                aria-controls="navbarSonetto" aria-expanded="false" aria-label="Ouvrir le menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        {# data-bs-target correspond à l'id de la div juste en dessous : c'est ce qui relie le bouton hamburger au menu #}
        <div class="collapse navbar-collapse" id="navbarSonetto">
            <ul class="navbar-nav mx-auto mb-3 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link {{ app.request.attributes.get('_route') == 'app_accueil' ? 'active' }}" href="{{ path('app_accueil') }}">Accueil</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ app.request.attributes.get('_route') == 'app_apropos' ? 'active' }}" href="{{ path('app_apropos') }}">À propos</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle {{ app.request.attributes.get('_route') == 'app_produits' ? 'active' }}"
                       href="{{ path('app_produits') }}" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Produits
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="{{ path('app_produits') }}">Tous les produits</a></li>
                        {% for categorie in categories_menu %}
                            <li><a class="dropdown-item" href="{{ path('app_produits') }}#categorie-{{ categorie.id }}">{{ categorie.nom }}</a></li>
                        {% endfor %}
                    </ul>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ app.request.attributes.get('_route') == 'app_contact' ? 'active' }}" href="{{ path('app_contact') }}">Contact</a>
                </li>
            </ul>

            {# Bouton WhatsApp toujours visible, y compris replié dans le menu mobile #}
            <a href="https://wa.me/{{ whatsapp_number }}?text={{ whatsapp_message_defaut|url_encode }}"
               target="_blank" rel="noopener" class="btn-whatsapp btn-whatsapp--sm">
                {{ include('partials/_icone_whatsapp.html.twig') }}
                Discuter sur WhatsApp
            </a>
        </div>
    </div>
</nav>

{# ==================== CONTENU DE LA PAGE ==================== #}
{% block body %}{% endblock %}

{# ==================== FOOTER (identique sur toutes les pages) ==================== #}
<footer class="footer">
    <div class="container">

        <div class="footer-badges">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="footer-badge">
                        <span class="icon-circle">💳</span>
                        Paiement après installation
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="footer-badge">
                        <span class="icon-circle">💬</span>
                        Support réactif
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="footer-badge">
                        <span class="icon-circle">🛡️</span>
                        Installation garantie
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 py-5">
            <div class="col-lg-4 col-md-6">
                <h4>{{ entreprise_nom }}</h4>
                <p class="text-white-50">Vente, installation et configuration de sonnettes vidéo connectées à domicile, {{ entreprise_zone }}.</p>
                <div class="footer-social mt-3">
                    <a href="#" aria-label="Facebook">FB</a>
                    <a href="#" aria-label="Instagram">IG</a>
                    <a href="https://wa.me/{{ whatsapp_number }}" target="_blank" rel="noopener" aria-label="WhatsApp">WA</a>
                </div>
            </div>
            <div class="col-lg-2 col-md-6">
                <h4>Navigation</h4>
                <a href="{{ path('app_accueil') }}">Accueil</a>
                <a href="{{ path('app_apropos') }}">À propos</a>
                <a href="{{ path('app_produits') }}">Produits</a>
                <a href="{{ path('app_contact') }}">Contact</a>
            </div>
            <div class="col-lg-3 col-md-6">
                <h4>Aide</h4>
                <a href="{{ path('app_contact') }}">Zone de couverture</a>
                <a href="{{ path('app_apropos') }}">Comment ça marche</a>
                <a href="#">Questions fréquentes</a>
            </div>
            <div class="col-lg-3 col-md-6">
                <h4>Contact</h4>
                <a href="mailto:{{ entreprise_email }}">{{ entreprise_email }}</a>
                <a href="tel:{{ entreprise_telephone|replace({' ': ''}) }}">{{ entreprise_telephone }}</a>
                <a href="https://wa.me/{{ whatsapp_number }}" target="_blank" rel="noopener">WhatsApp direct</a>
            </div>
        </div>

        <div class="footer-bottom">
            &copy; {{ "now"|date('Y') }} {{ entreprise_nom }} — TVA BE0000.000.000 — Tous droits réservés.
        </div>
    </div>
</footer>

{# Bouton WhatsApp flottant, visible sur toutes les pages (surtout utile en scrollant sur mobile) #}
<a href="https://wa.me/{{ whatsapp_number }}?text={{ whatsapp_message_defaut|url_encode }}"
   target="_blank" rel="noopener" class="whatsapp-float" aria-label="Discuter sur WhatsApp">
    {{ include('partials/_icone_whatsapp.html.twig') }}
</a>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="{{ asset('js/script.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
