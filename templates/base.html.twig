<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>
			{% block title %}
				{{ entreprise_nom }}
				| Sonnettes vidéo connectées
			{% endblock %}
		</title>
		{# 1. Balise d'auto-référence (la page actuelle) #}
		<link rel="alternate" hreflang="{{ app.request.locale }}" href="{{ url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}"/>
		{# 2. Boucle sur les autres langues disponibles #}
		{% for code_langue in ['fr', 'en', 'es', 'nl'] %}
			{% if code_langue != app.request.locale %}
				<link rel="alternate" hreflang="{{ code_langue }}" href="{{ url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': code_langue})) }}"/>
			{% endif %}
		{% endfor %}
		<meta
		name="description" content="{% block meta_description %}{% trans %}Vente, installation et configuration de sonnettes vidéo connectées à Bruxelles. Payez seulement après installation.{% endtrans %}{% endblock %}">

		{# URL canonique : évite les problèmes de contenu dupliqué (ex: mêmes pages
										       accessibles avec ou sans paramètres de tracking). #}
		<link rel="canonical" href="{{ url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}">
		<link
		rel="icon" href="{{ asset('images/logo.svg') }}">

		{# Open Graph / Twitter Card : aperçu soigné quand le site est partagé
										       (WhatsApp, Facebook, etc.). Réutilise les blocks title/meta_description
										       ci-dessus, sauf si une page les redéfinit spécifiquement (og_image). #}
		<meta property="og:type" content="website">
		<meta property="og:site_name" content="{{ entreprise_nom }}">
		{% set og_locales = {'fr': 'fr_BE', 'en': 'en_US', 'es': 'es_ES', 'nl': 'nl_BE'} %}
		<meta property="og:locale" content="{{ og_locales[app.request.locale]|default('fr_BE') }}">
		<meta property="og:url" content="{{ url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}">
		<meta property="og:title" content="{{ block('title') }}">
		<meta property="og:description" content="{{ block('meta_description') }}">
		<meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('images/hero-photo.jpg')) }}{% endblock %}">
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content="{{ block('title') }}">
		<meta name="twitter:description" content="{{ block('meta_description') }}">
		<meta
		name="twitter:image" content="{{ block('og_image') }}">

		{# Bootstrap : uniquement pour la grille/flexbox (container, row, col-*, d-flex...) #}
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
		<link
		rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
		{# Drapeaux du sélecteur de langue (classes fi / fi-fr, fi-gb, fi-nl, fi-es) #}
		<link
		rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flag-icons@7.2.3/css/flag-icons.min.css">
		{# Notre design (couleurs, cartes, navbar, footer, hero...) #}
		<link href="{{ asset('css/style.css') }}" rel="stylesheet">

		{# Données structurées (JSON-LD) : aide Google à comprendre qu'il s'agit
										       d'une entreprise locale (adresse, téléphone, zone desservie), utile
										       pour apparaître dans les résultats de recherche locaux ("sonnette
										       connectée Bruxelles") et sur Google Maps. #}
		 <script type="application/ld+json">
										    {
										        "@context": "https://schema.org",
										        "@type": "ElectronicsStore",
										        "name": {{ entreprise_nom|json_encode|raw }},
										        "url": {{ url('app_accueil')|json_encode|raw }},
										        "email": {{ entreprise_email|json_encode|raw }},
										        "telephone": {{ entreprise_telephone|json_encode|raw }},
										        "image": {{ absolute_url(asset('images/logo.svg'))|json_encode|raw }},
										        "address": {
										            "@type": "PostalAddress",
										            "addressLocality": "Bruxelles",
										            "addressCountry": "BE"
										        },
										        "areaServed": {{ entreprise_zone|json_encode|raw }}
										    }
										    </script>{% block stylesheets %}
	{% endblock %}
	</head>
		<body>

		{# ==================== NAVBAR (identique sur toutes les pages) ==================== #}
			<nav class="navbar navbar-expand-lg navbar-sonetto sticky-top"> <div class="container">
				<a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('app_accueil') }}">
					<img src="{{ asset('images/logo.svg') }}" alt="{{ entreprise_nom }}" height="54">
				</a>

				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSonetto" aria-controls="navbarSonetto" aria-expanded="false" aria-label="{% trans %}Ouvrir le menu{% endtrans %}">
					<span class="navbar-toggler-icon"></span>
				</button>

				{# data-bs-target correspond à l'id de la div juste en dessous : c'est ce qui relie le bouton hamburger au menu #}
				<div class="collapse navbar-collapse" id="navbarSonetto">
					<ul class="navbar-nav mx-auto mb-3 mb-lg-0">
						<li class="nav-item">
							<a class="nav-link {{ app.request.attributes.get('_route') == 'app_accueil' ? 'active' }}" href="{{ path('app_accueil') }}">{% trans %}Accueil{% endtrans %}</a>
						</li>
						<li class="nav-item">
							<a class="nav-link {{ app.request.attributes.get('_route') == 'app_apropos' ? 'active' }}" href="{{ path('app_apropos') }}">{% trans %}À propos{% endtrans %}</a>
						</li>
						<li class="nav-item">
							<a class="nav-link {{ app.request.attributes.get('_route') == 'app_produits' ? 'active' }}" href="{{ path('app_produits') }}">{% trans %}Produits{% endtrans %}</a>
						</li>
						<li class="nav-item">
							<a class="nav-link {{ app.request.attributes.get('_route') == 'app_contact' ? 'active' }}" href="{{ path('app_contact') }}">{% trans %}Contact{% endtrans %}</a>
						</li>
					</ul>

					{# Bouton WhatsApp toujours visible, y compris replié dans le menu mobile #}
					<a href="https://wa.me/{{ whatsapp_number }}?text={{ whatsapp_message_defaut|url_encode }}" target="_blank" rel="noopener" class="btn-whatsapp btn-whatsapp--sm">
						{{ include('partials/_icone_whatsapp.html.twig') }}
						{% trans %}Discuter sur WhatsApp{% endtrans %}
					</a>

					{% set flags = {'fr': 'fi-fr', 'en': 'fi-gb', 'nl': 'fi-nl', 'es': 'fi-es'} %}
					{% set locale_labels = {'fr': 'Français', 'en': 'English', 'nl': 'Nederlands', 'es': 'Español'} %}
					<ul class="language-switcher list-unstyled mb-0">
						<li class="dropdown">
							<a href="#" class="language-switcher__toggle" aria-label="{% trans %}Choisir la langue{% endtrans %}">
								<span class="fi {{ flags[app.request.locale]|default('fi-fr') }}"></span>
								<i class="bi bi-chevron-down toggle-dropdown"></i>
							</a>
							<ul>
								{% for locale, flag in flags %}
									<li>
										<a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': locale})) }}" class="{{ app.request.locale == locale ? 'active' : '' }}" title="{{ locale_labels[locale] }}">
											<span class="fi {{ flag }}"></span>
										</a>
									</li>
								{% endfor %}
							</ul>
						</li>
					</ul>

				</div>
			</div>
		</nav>

		{# ==================== CONTENU DE LA PAGE ==================== #}
		{% block body %}{% endblock %}

		{# ==================== FOOTER (identique sur toutes les pages) ==================== #}
		<footer class="footer mt-0">
			<div class="container">

				<div class="footer-badges">
					<div class="row g-4">
						<div class="col-md-4">
							<div class="footer-badge">
								<span class="icon-circle">
									<i class="bi bi-credit-card"></i>
								</span>
								{% trans %}Paiement après installation{% endtrans %}
							</div>
						</div>
						<div class="col-md-4">
							<div class="footer-badge">
								<span class="icon-circle">
									<i class="bi bi-headset"></i>
								</span>
								{% trans %}Support réactif{% endtrans %}
							</div>
						</div>
						<div class="col-md-4">
							<div class="footer-badge">
								<span class="icon-circle">
									<i class="bi bi-shield-check"></i>
								</span>
								{% trans %}Installation garantie{% endtrans %}
							</div>
						</div>
					</div>
				</div>

				<div class="row g-4 py-5">
					<div class="col-6 col-lg-4">
						<div class="footer-brand mb-3">
							<img src="{{ asset('images/logo-blanc.svg') }}" alt="{{ entreprise_nom }}" height="46">
						</div>
						<p class="text-white-50">{% trans %}Vente, installation et configuration de sonnettes vidéo connectées à domicile,{% endtrans %}
							{{ entreprise_zone }}.</p>
						<div class="footer-social mt-3">
							<a href="#" aria-label="Facebook">
								<i class="bi bi-facebook"></i>
							</a>
							<a href="#" aria-label="Instagram">
								<i class="bi bi-instagram"></i>
							</a>
							<a href="https://wa.me/{{ whatsapp_number }}" target="_blank" rel="noopener" aria-label="WhatsApp">
								<i class="bi bi-whatsapp"></i>
							</a>
						</div>
					</div>
					<div class="col-6 col-lg-2">
						<h4>{% trans %}Navigation{% endtrans %}</h4>
						<a href="{{ path('app_accueil') }}">{% trans %}Accueil{% endtrans %}</a>
						<a href="{{ path('app_apropos') }}">{% trans %}À propos{% endtrans %}</a>
						<a href="{{ path('app_produits') }}">{% trans %}Produits{% endtrans %}</a>
						<a href="{{ path('app_contact') }}">{% trans %}Contact{% endtrans %}</a>
					</div>
					<div class="col-6 col-lg-3">
						<h4>{% trans %}Aide{% endtrans %}</h4>
						<a href="{{ path('app_contact') }}">{% trans %}Zone de couverture{% endtrans %}</a>
						<a href="{{ path('app_apropos') }}">{% trans %}Comment ça marche{% endtrans %}</a>
						<a href="#">{% trans %}Questions fréquentes{% endtrans %}</a>
					</div>
					<div class="col-6 col-lg-3">
						<h4>{% trans %}Contact{% endtrans %}</h4>
						<a href="mailto:{{ entreprise_email }}">{{ entreprise_email }}</a>
						<a href="tel:{{ entreprise_telephone|replace({' ': ''}) }}">{{ entreprise_telephone }}</a>
						<a href="https://wa.me/{{ whatsapp_number }}" target="_blank" rel="noopener">{% trans %}WhatsApp direct{% endtrans %}</a>
					</div>
				</div>

				<div class="footer-bottom">
					&copy;
					{{ "now"|date('Y') }}
					{{ entreprise_nom }}
					—
					{% trans %}Tous droits réservés.{% endtrans %}
				</div>
			</div>
		</footer>

		{# Bouton WhatsApp flottant, visible sur toutes les pages (surtout utile en scrollant sur mobile) #}
		<a href="https://wa.me/{{ whatsapp_number }}?text={{ whatsapp_message_defaut|url_encode }}" target="_blank" rel="noopener" class="whatsapp-float" aria-label="{% trans %}Discuter sur WhatsApp{% endtrans %}">
			{{ include('partials/_icone_whatsapp.html.twig') }}
		</a>

		 <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
		 <script src="{{ asset('js/script.js') }}"></script>
		{% block javascripts %}{% endblock %}
		{% block importmap %}
			{{ importmap('app') }}
		{% endblock %}
	</body>
</html>
