<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Administration{% endblock %} · Sonetto</title>
        <link rel="icon" href="{{ asset('images/logo.svg') }}">

        {# Bootstrap sert uniquement de mise en page rapide pour le back-office (pas de design custom ici). #}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

        {% block stylesheets %}{% endblock %}
    </head>
    <body class="bg-light">
        <nav class="navbar navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_accueil') }}">Sonetto · Administration</a>
                <div class="d-flex gap-3">
                    <a href="{{ path('app_produit_index') }}" class="nav-link text-white">Produits</a>
                    <a href="{{ path('app_categorie_index') }}" class="nav-link text-white">Catégories</a>
                    <a href="{{ path('app_accueil') }}" class="nav-link text-white-50">← Retour au site</a>
                </div>
            </div>
        </nav>

        <main class="container pb-5">
            {% block body %}{% endblock %}
        </main>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
