{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}{% trans %}Tableau de bord{% endtrans %}{% endblock %}

{% block main %}
    <div class="row g-3 mb-4">
        {% for stat in kpis %}
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0"
                             style="width: 46px; height: 46px; background: {{ stat.color }};">
                            <i class="fas {{ stat.icon }}"></i>
                        </div>
                        <div>
                            <div class="small text-uppercase text-muted fw-semibold">{{ stat.label }}</div>
                            <div class="fs-4 fw-bold">{{ stat.value }}</div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <h5 class="card-title mb-3">{% trans %}Bienvenue dans l'administration{% endtrans %} {{ entreprise_nom }}</h5>
            <p class="text-muted mb-0">
                {% trans %}Utilisez le menu à gauche pour gérer vos produits, catégories et la galerie photo. Pense à cocher "Actif" sur un produit pour qu'il apparaisse sur le site public.{% endtrans %}
            </p>
        </div>
    </div>
{% endblock %}
