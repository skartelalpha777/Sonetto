<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Administration {{ entreprise_nom }}{% endblock %}</title>
    <link rel="icon" href="{{ asset('images/logo.svg') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link href="{{ asset('css/style.css') }}" rel="stylesheet">
    <style>
        body.login-body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg, var(--color-dark) 0%, var(--color-dark-2) 60%, #1d3a63 100%);
            padding: 1.5rem;
        }
        .login-card {
            background: #fff;
            border-radius: var(--radius);
            box-shadow: var(--shadow-md);
            padding: 2.5rem;
            width: 100%;
            max-width: 420px;
        }
        .login-card .login-logo {
            display: block;
            margin: 0 auto 1.5rem;
        }
        .login-card h1 {
            font-size: 1.4rem;
            text-align: center;
            margin-bottom: 0.75rem;
        }
        .login-card p.subtitle {
            text-align: center;
            color: var(--color-muted);
            font-size: 0.92rem;
            margin-bottom: 1.75rem;
        }
        .login-card label {
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 0.35rem;
        }
    </style>
</head>
<body class="login-body">
    <div class="login-card">
        <img src="{{ asset('images/logo.svg') }}" alt="{{ entreprise_nom }}" height="46" class="login-logo">
        {% block card_content %}{% endblock %}
    </div>
</body>
</html>
