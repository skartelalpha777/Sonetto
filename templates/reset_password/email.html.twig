<p>{% trans %}Bonjour,{% endtrans %}</p>

<p>{% trans %}Une demande de réinitialisation de mot de passe a été faite pour votre compte administrateur{% endtrans %} {{ entreprise_nom }}.</p>

<p>
    <a href="{{ url('app_reset_password', {token: resetToken.token}) }}">
        {% trans %}Cliquez ici pour choisir un nouveau mot de passe{% endtrans %}
    </a>
</p>

<p>{% trans with {'%duree%': resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle')} %}Ce lien est valable %duree%.{% endtrans %}</p>

<p>{% trans %}Si vous n'êtes pas à l'origine de cette demande, vous pouvez ignorer cet email.{% endtrans %}</p>
