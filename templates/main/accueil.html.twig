{% extends 'base.html.twig' %}

{% block title %}{{ entreprise_nom }} — Sonnettes vidéo connectées à Bruxelles{% endblock %}

{% block body %}

    {# ==================== HERO ==================== #}
    <section class="hero">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <span class="hero-badge">✓ Payez seulement après installation</span>
                    <h1>Une sonnette vidéo connectée, <span class="highlight">installée chez vous</span>, sans risque</h1>
                    <p class="lead">
                        Pas de devis interminable, pas d'acompte à verser à l'avance.
                        Nous installons votre sonnette vidéo à domicile et vous ne payez
                        qu'une fois totalement satisfait.
                    </p>
                    <div class="d-flex flex-wrap gap-3 mt-4">
                        <a href="https://wa.me/{{ whatsapp_number }}?text={{ whatsapp_message_defaut|url_encode }}"
                           target="_blank" rel="noopener" class="btn-whatsapp btn-whatsapp--lg">
                            {{ include('partials/_icone_whatsapp.html.twig') }}
                            Discuter sur WhatsApp
                        </a>
                        <a href="{{ path('app_produits') }}" class="btn-outline-primary-custom">
                            Voir les modèles
                        </a>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="hero-image-wrapper text-center">
                        <img src="{{ asset('images/hero-sonnette.svg') }}" alt="Sonnette vidéo connectée" class="img-fluid" style="max-width: 380px;">
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ==================== POURQUOI NOUS CHOISIR ==================== #}
    <section class="section">
        <div class="container">
            <div class="section-title">
                <h2>Pourquoi nous choisir</h2>
                <p>Une installation sans mauvaise surprise, pensée pour votre tranquillité.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="icon-circle">💳</div>
                        <h3>Paiement après installation</h3>
                        <p>Aucun acompte demandé. Vous réglez uniquement une fois la sonnette installée et testée.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="icon-circle">🛠️</div>
                        <h3>Installation pro incluse</h3>
                        <p>Un technicien se déplace chez vous et configure entièrement votre appareil.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="icon-circle">📱</div>
                        <h3>Même quand vous êtes absent</h3>
                        <p>Voyez et parlez à vos visiteurs depuis votre smartphone, où que vous soyez.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="feature-card">
                        <div class="icon-circle">🚫</div>
                        <h3>Sans abonnement possible</h3>
                        <p>Des modèles avec stockage local, sans frais mensuels obligatoires.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ==================== NOS PRODUITS ==================== #}
    <section class="section bg-alt">
        <div class="container">
            <div class="section-title">
                <h2>Nos produits</h2>
                <p>Une sélection de sonnettes vidéo connectées, installées et configurées pour vous.</p>
            </div>

            {% if produits_vedette is empty %}
                <p class="text-center text-muted">Aucun produit publié pour le moment. Ajoutez-en depuis l'espace <a href="{{ path('app_produit_index') }}">administration</a>.</p>
            {% else %}
                <div class="row g-4">
                    {% for produit in produits_vedette %}
                        {{ include('partials/_carte_produit.html.twig', { produit: produit }) }}
                    {% endfor %}
                </div>
                <div class="text-center mt-5">
                    <a href="{{ path('app_produits') }}" class="btn-outline-primary-custom">Voir tous les produits</a>
                </div>
            {% endif %}
        </div>
    </section>

    {# ==================== COMMENT CA MARCHE ==================== #}
    <section class="section">
        <div class="container">
            <div class="section-title">
                <h2>Comment ça marche</h2>
                <p>Trois étapes simples, sans engagement avant l'installation.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="etape">
                        <div class="etape__numero">1</div>
                        <h3>Contact WhatsApp</h3>
                        <p>Vous nous écrivez le modèle qui vous intéresse et votre disponibilité.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="etape">
                        <div class="etape__numero">2</div>
                        <h3>Installation à domicile</h3>
                        <p>Notre technicien installe et configure la sonnette chez vous.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="etape">
                        <div class="etape__numero">3</div>
                        <h3>Paiement une fois satisfait</h3>
                        <p>Vous testez l'appareil et ne payez que si tout fonctionne comme prévu.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ==================== NEWSLETTER ==================== #}
    <section class="section bg-alt">
        <div class="container">
            <div class="newsletter">
                <h2>Restez informé de nos nouveaux modèles</h2>
                <p class="mb-4">Recevez nos offres et nouveautés, sans spam.</p>
                <form id="newsletter-form" class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                    <input type="email" class="form-control" style="max-width: 320px;" placeholder="Votre adresse e-mail" required>
                    <button type="submit">S'inscrire</button>
                </form>
                <p id="newsletter-message" class="mt-3 d-none"></p>
            </div>
        </div>
    </section>

{% endblock %}
