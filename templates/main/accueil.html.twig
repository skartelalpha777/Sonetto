{% extends 'base.html.twig' %}

{% block title %}{{ entreprise_nom }} | Sonnettes vidéo connectées{% endblock %}
{% block meta_description %}{% trans %}Vente et installation de sonnettes vidéo connectées à Bruxelles : caméra, détection intelligente, carillon. Payez seulement après installation, sans acompte.{% endtrans %}{% endblock %}

{% block body %}

    {# ==================== HERO ==================== #}
    <section class="hero">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <span class="hero-badge"><i class="bi bi-shield-check"></i> {% trans %}Votre sécurité, notre priorité{% endtrans %}</span>
                    <h1>{% trans %}Une sonnette vidéo connectée, installée chez vous, <span class="highlight">sans risque</span>{% endtrans %}</h1>
                    <p class="lead">
                        {% trans %}Surveillez votre porte, où que vous soyez.{% endtrans %} {{ entreprise_nom }} {% trans %}vous propose des sonnettes vidéo connectées de qualité, avec une installation professionnelle et une configuration complète.{% endtrans %}
                    </p>

                    <div class="row hero-features g-3">
                        <div class="col-lg-3 col-sm-6">
                            <div class="hero-feature">
                                <span class="icon-circle"><i class="bi bi-eye"></i></span>
                                <div>
                                    <strong>{% trans %}Vision HD{% endtrans %}</strong>
                                    <span>{% trans %}Jour et nuit{% endtrans %}</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6">
                            <div class="hero-feature">
                                <span class="icon-circle"><i class="bi bi-bell"></i></span>
                                <div>
                                    <strong>{% trans %}Détection de mouvement{% endtrans %}</strong>
                                    <span>{% trans %}Alertes en temps réel{% endtrans %}</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6">
                            <div class="hero-feature">
                                <span class="icon-circle"><i class="bi bi-mic"></i></span>
                                <div>
                                    <strong>{% trans %}Communication bidirectionnelle{% endtrans %}</strong>
                                    <span>{% trans %}Parlez et écoutez{% endtrans %}</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6">
                            <div class="hero-feature">
                                <span class="icon-circle"><i class="bi bi-phone"></i></span>
                                <div>
                                    <strong>{% trans %}Accès à distance{% endtrans %}</strong>
                                    <span>{% trans %}Depuis votre smartphone{% endtrans %}</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-3">
                        <a href="https://wa.me/{{ whatsapp_number }}?text={{ whatsapp_message_defaut|url_encode }}"
                           target="_blank" rel="noopener" class="btn-pill btn-pill--lg">
                            {{ include('partials/_icone_whatsapp.html.twig') }}
                            {% trans %}Discuter sur WhatsApp{% endtrans %}
                        </a>
                        <a href="{{ path('app_produits') }}" class="btn-outline-light-custom">
                            {% trans %}Voir nos produits{% endtrans %}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ==================== NOS PRODUITS ==================== #}
    <section class="section bg-white">
        <div class="container">
            <div class="section-title">
                <span class="section-eyebrow">{% trans %}Nos produits{% endtrans %}</span>
                <h2>{{ ('%count% modèle pour répondre à tous vos besoins|%count% modèles pour répondre à tous vos besoins')|trans({'%count%': produits_vedette|length}) }}</h2>
                <p>{% trans %}Choisissez la sonnette connectée qui vous convient. Tous nos modèles sont livrés avec une installation professionnelle et une configuration complète.{% endtrans %}</p>
            </div>

            {% if produits_vedette is empty %}
                <p class="text-center text-muted">
                    {% trans with {'%url%': path('admin')} %}Aucun produit publié pour le moment. Ajoutez-en depuis l'espace <a href="%url%">administration</a>.{% endtrans %}
                </p>
            {% else %}
                <div class="row g-4">
                    {% for produit in produits_vedette %}
                        {{ include('partials/_carte_produit.html.twig', { produit: produit, badge: loop.index == 2 ? ('Le plus populaire'|trans) : null }) }}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>

    {# ==================== POURQUOI NOUS CHOISIR ==================== #}
    <section class="section bg-alt">
        <div class="container">
            <div class="section-title">
                <span class="section-eyebrow">{% trans %}Pourquoi choisir{% endtrans %} {{ entreprise_nom }} ?</span>
                <h2>{% trans %}Une solution complète et sans tracas{% endtrans %}</h2>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="feature-plain">
                        <div class="icon-circle"><i class="bi bi-award"></i></div>
                        <h3>{% trans %}Matériel de qualité{% endtrans %}</h3>
                        <p>{% trans %}Des marques fiables et performantes.{% endtrans %}</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="feature-plain">
                        <div class="icon-circle"><i class="bi bi-tools"></i></div>
                        <h3>{% trans %}Installation professionnelle{% endtrans %}</h3>
                        <p>{% trans %}Par nos techniciens certifiés.{% endtrans %}</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="feature-plain">
                        <div class="icon-circle"><i class="bi bi-gear"></i></div>
                        <h3>{% trans %}Configuration incluse{% endtrans %}</h3>
                        <p>{% trans %}Application, réseau et réglages.{% endtrans %}</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="feature-plain">
                        <div class="icon-circle"><i class="bi bi-headset"></i></div>
                        <h3>{% trans %}Support réactif{% endtrans %}</h3>
                        <p>{% trans %}Une équipe à votre écoute.{% endtrans %}</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ==================== NOTRE ENGAGEMENT ==================== #}
    <section class="section">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6 engagement-image">
                    <img src="{{ asset('images/installation-illustration.svg') }}" alt="{% trans %}Installation d'une sonnette connectée par un technicien{% endtrans %}">
                </div>
                <div class="col-lg-6">
                    <span class="section-eyebrow" style="text-align:left;">{% trans %}Notre engagement{% endtrans %}</span>
                    <h2>{% trans %}Une installation simple et rapide{% endtrans %}</h2>
                    <p class="text-muted">
                        {% trans %}Nos techniciens s'occupent de tout : pose de la sonnette, configuration de votre application et tests de fonctionnement. Vous n'avez rien à gérer, et vous ne payez qu'une fois l'installation validée.{% endtrans %}
                    </p>
                </div>
            </div>
        </div>
    </section>

    {# ==================== COMMENT CA MARCHE ==================== #}
    <section class="section bg-alt">
        <div class="container">
            <div class="section-title">
                <span class="section-eyebrow">{% trans %}Comment ça marche{% endtrans %}</span>
                <h2>{% trans %}Trois étapes simples, sans engagement avant l'installation{% endtrans %}</h2>
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="etape">
                        <div class="etape__numero">1</div>
                        <h3>{% trans %}Contact WhatsApp{% endtrans %}</h3>
                        <p>{% trans %}Vous nous écrivez le modèle qui vous intéresse et votre disponibilité.{% endtrans %}</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="etape">
                        <div class="etape__numero">2</div>
                        <h3>{% trans %}Installation à domicile{% endtrans %}</h3>
                        <p>{% trans %}Notre technicien installe et configure la sonnette chez vous.{% endtrans %}</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="etape">
                        <div class="etape__numero">3</div>
                        <h3>{% trans %}Paiement une fois satisfait{% endtrans %}</h3>
                        <p>{% trans %}Vous testez l'appareil et ne payez que si tout fonctionne comme prévu.{% endtrans %}</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ==================== BANDEAU CTA FINAL ==================== #}
    <section class="section">
        <div class="container">
            <div class="cta-banner text-center">
                <h2>{% trans %}Prêt à sécuriser votre entrée ?{% endtrans %}</h2>
                <p class="mb-4">{% trans %}Discutez avec notre équipe sur WhatsApp pour obtenir un devis personnalisé.{% endtrans %}</p>
                <a href="https://wa.me/{{ whatsapp_number }}?text={{ whatsapp_message_defaut|url_encode }}"
                   target="_blank" rel="noopener" class="btn-whatsapp btn-whatsapp--lg">
                    {{ include('partials/_icone_whatsapp.html.twig') }}
                    {% trans %}Discuter sur WhatsApp{% endtrans %}
                </a>
            </div>
        </div>
    </section>

{% endblock %}
