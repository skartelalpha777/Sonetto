{% extends 'base.html.twig' %}

{% block title %}{{ entreprise_nom }} | Sonnettes vidéo connectées{% endblock %}
{% block meta_description %}Vente et installation de sonnettes vidéo connectées à Bruxelles : caméra, détection intelligente, carillon. Payez seulement après installation, sans acompte.{% endblock %}

{% block body %}

    {# ==================== HERO ==================== #}
    <section class="hero">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <span class="hero-badge"><i class="bi bi-shield-check"></i> Votre sécurité, notre priorité</span>
                    <h1>Une sonnette vidéo connectée, installée chez vous, <span class="highlight">sans risque</span></h1>
                    <p class="lead">
                        Surveillez votre porte, où que vous soyez. {{ entreprise_nom }} vous propose des sonnettes
                        vidéo connectées de qualité, avec une installation professionnelle et une configuration complète.
                    </p>

                    <div class="row hero-features g-3">
                        <div class="col-lg-3 col-sm-6">
                            <div class="hero-feature">
                                <span class="icon-circle"><i class="bi bi-eye"></i></span>
                                <div>
                                    <strong>Vision HD</strong>
                                    <span>Jour et nuit</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6">
                            <div class="hero-feature">
                                <span class="icon-circle"><i class="bi bi-bell"></i></span>
                                <div>
                                    <strong>Détection de mouvement</strong>
                                    <span>Alertes en temps réel</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6">
                            <div class="hero-feature">
                                <span class="icon-circle"><i class="bi bi-mic"></i></span>
                                <div>
                                    <strong>Communication bidirectionnelle</strong>
                                    <span>Parlez et écoutez</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6">
                            <div class="hero-feature">
                                <span class="icon-circle"><i class="bi bi-phone"></i></span>
                                <div>
                                    <strong>Accès à distance</strong>
                                    <span>Depuis votre smartphone</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-3">
                        <a href="https://wa.me/{{ whatsapp_number }}?text={{ whatsapp_message_defaut|url_encode }}"
                           target="_blank" rel="noopener" class="btn-pill btn-pill--lg">
                            {{ include('partials/_icone_whatsapp.html.twig') }}
                            Discuter sur WhatsApp
                        </a>
                        <a href="{{ path('app_produits') }}" class="btn-outline-light-custom">
                            Voir nos produits
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ==================== NOS PRODUITS ==================== #}
    <section class="section bg-white">
        <div class="container">
            <div class="section-title">
                <span class="section-eyebrow">Nos produits</span>
                <h2>{{ produits_vedette|length }} modèle{{ produits_vedette|length > 1 ? 's' }} pour répondre à tous vos besoins</h2>
                <p>Choisissez la sonnette connectée qui vous convient. Tous nos modèles sont livrés avec une installation professionnelle et une configuration complète.</p>
            </div>

            {% if produits_vedette is empty %}
                <p class="text-center text-muted">Aucun produit publié pour le moment. Ajoutez-en depuis l'espace <a href="{{ path('admin') }}">administration</a>.</p>
            {% else %}
                <div class="row g-4">
                    {% for produit in produits_vedette %}
                        {{ include('partials/_carte_produit.html.twig', { produit: produit, badge: loop.index == 2 ? 'Le plus populaire' : null }) }}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>

    {# ==================== POURQUOI NOUS CHOISIR ==================== #}
    <section class="section bg-alt">
        <div class="container">
            <div class="section-title">
                <span class="section-eyebrow">Pourquoi choisir {{ entreprise_nom }} ?</span>
                <h2>Une solution complète et sans tracas</h2>
            </div>
            <div class="row g-4">
                <div class="col-md-6 col-lg-3">
                    <div class="feature-plain">
                        <div class="icon-circle"><i class="bi bi-award"></i></div>
                        <h3>Matériel de qualité</h3>
                        <p>Des marques fiables et performantes.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="feature-plain">
                        <div class="icon-circle"><i class="bi bi-tools"></i></div>
                        <h3>Installation professionnelle</h3>
                        <p>Par nos techniciens certifiés.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="feature-plain">
                        <div class="icon-circle"><i class="bi bi-gear"></i></div>
                        <h3>Configuration incluse</h3>
                        <p>Application, réseau et réglages.</p>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3">
                    <div class="feature-plain">
                        <div class="icon-circle"><i class="bi bi-headset"></i></div>
                        <h3>Support réactif</h3>
                        <p>Une équipe à votre écoute.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ==================== NOTRE ENGAGEMENT ==================== #}
    <section class="section">
        <div class="container">
            <div class="row g-5 align-items-center">
                <div class="col-lg-6 engagement-image">
                    <img src="{{ asset('images/installation-illustration.svg') }}" alt="Installation d'une sonnette connectée par un technicien">
                </div>
                <div class="col-lg-6">
                    <span class="section-eyebrow" style="text-align:left;">Notre engagement</span>
                    <h2>Une installation simple et rapide</h2>
                    <p class="text-muted">
                        Nos techniciens s'occupent de tout : pose de la sonnette, configuration de votre
                        application et tests de fonctionnement. Vous n'avez rien à gérer, et vous ne payez
                        qu'une fois l'installation validée.
                    </p>
                </div>
            </div>
        </div>
    </section>

    {# ==================== COMMENT CA MARCHE ==================== #}
    <section class="section bg-alt">
        <div class="container">
            <div class="section-title">
                <span class="section-eyebrow">Comment ça marche</span>
                <h2>Trois étapes simples, sans engagement avant l'installation</h2>
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="etape">
                        <div class="etape__numero">1</div>
                        <h3>Contact WhatsApp</h3>
                        <p>Vous nous écrivez le modèle qui vous intéresse et votre disponibilité.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="etape">
                        <div class="etape__numero">2</div>
                        <h3>Installation à domicile</h3>
                        <p>Notre technicien installe et configure la sonnette chez vous.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="etape">
                        <div class="etape__numero">3</div>
                        <h3>Paiement une fois satisfait</h3>
                        <p>Vous testez l'appareil et ne payez que si tout fonctionne comme prévu.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ==================== BANDEAU CTA FINAL ==================== #}
    <section class="section">
        <div class="container">
            <div class="cta-banner text-center">
                <h2>Prêt à sécuriser votre entrée ?</h2>
                <p class="mb-4">Discutez avec notre équipe sur WhatsApp pour obtenir un devis personnalisé.</p>
                <a href="https://wa.me/{{ whatsapp_number }}?text={{ whatsapp_message_defaut|url_encode }}"
                   target="_blank" rel="noopener" class="btn-whatsapp btn-whatsapp--lg">
                    {{ include('partials/_icone_whatsapp.html.twig') }}
                    Discuter sur WhatsApp
                </a>
            </div>
        </div>
    </section>

{% endblock %}
