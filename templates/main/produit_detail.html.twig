{% extends 'base.html.twig' %}

{% block title %}{{ produit.nom }} — {{ entreprise_nom }}{% endblock %}
{% block meta_description %}{{ produit.sousTitre ?: produit.nom }} — {{ produit.prix|number_format(0, ',', ' ') }} €, {% trans %}installation et configuration incluses à Bruxelles.{% endtrans %}{% endblock %}
{% block og_image %}{{ produit.imagePrincipale ? absolute_url(asset('images/produits/' ~ produit.imagePrincipale)) : parent() }}{% endblock %}

{% block stylesheets %}
    {# Données structurées Product : permet à Google d'afficher le prix
       directement dans les résultats de recherche pour ce modèle. #}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": {{ produit.nom|json_encode|raw }},
        "description": {{ (produit.sousTitre ?: produit.nom)|json_encode|raw }},
        "image": {{ (produit.imagePrincipale ? absolute_url(asset('images/produits/' ~ produit.imagePrincipale)) : absolute_url(asset('images/placeholder-produit.svg')))|json_encode|raw }},
        "sku": {{ produit.id|json_encode|raw }},
        "brand": {
            "@type": "Brand",
            "name": {{ entreprise_nom|json_encode|raw }}
        },
        "offers": {
            "@type": "Offer",
            "priceCurrency": "EUR",
            "price": {{ produit.prix|json_encode|raw }},
            "availability": {{ (produit.aVenir ? "https://schema.org/PreOrder" : "https://schema.org/InStock")|json_encode|raw }},
            "url": {{ url('app_produit_detail', {id: produit.id})|json_encode|raw }}
        }
    }
    </script>
{% endblock %}

{% block body %}

    <header class="page-header">
        <div class="container">
            <a href="{{ path('app_produits') }}" class="page-header__retour">
                <i class="bi bi-arrow-left"></i> {% trans %}Retour aux produits{% endtrans %}
            </a>
            <h1>{{ produit.nom }}</h1>
            <p>{{ produit.categorie.getTranslatedNom(app.request.locale) }}</p>
        </div>
    </header>

    <section class="section">
        <div class="container">
            <div class="row g-5">

                {# ==================== CARROUSEL PHOTOS ==================== #}
                <div class="col-lg-6">
                    {% set images = produit.galerieComplete %}
                    {% if images|length > 1 %}
                        <div id="carousel-produit-{{ produit.id }}" class="carousel slide produit-carousel" data-bs-ride="carousel" data-bs-interval="3500">
                            <div class="carousel-indicators">
                                {% for img in images %}
                                    <button type="button" data-bs-target="#carousel-produit-{{ produit.id }}" data-bs-slide-to="{{ loop.index0 }}" class="{{ loop.first ? 'active' }}" aria-current="{{ loop.first ? 'true' }}" aria-label="{{ ('Photo %num%')|trans({'%num%': loop.index}) }}"></button>
                                {% endfor %}
                            </div>
                            <div class="carousel-inner">
                                {% for img in images %}
                                    <div class="carousel-item {{ loop.first ? 'active' }}">
                                        {# La 1ère photo (visible immédiatement) charge en priorité ;
                                           les suivantes ne se chargent que si l'utilisateur les affiche. #}
                                        <img src="{{ asset('images/produits/' ~ img) }}" class="d-block w-100"
                                             alt="{{ produit.nom }} — {{ ('Photo %num%')|trans({'%num%': loop.index}) }}"
                                             loading="{{ loop.first ? 'eager' : 'lazy' }}">
                                    </div>
                                {% endfor %}
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#carousel-produit-{{ produit.id }}" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">{% trans %}Précédent{% endtrans %}</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#carousel-produit-{{ produit.id }}" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">{% trans %}Suivant{% endtrans %}</span>
                            </button>
                        </div>
                    {% else %}
                        <div class="produit-carousel produit-carousel--simple">
                            <img src="{{ images[0] is defined ? asset('images/produits/' ~ images[0]) : asset('images/placeholder-produit.svg') }}"
                                 class="d-block w-100" alt="{{ produit.nom }}">
                        </div>
                    {% endif %}
                </div>

                {# ==================== INFOS PRODUIT ==================== #}
                <div class="col-lg-6">
                    <span class="produit-card__categorie">{{ produit.categorie.getTranslatedNom(app.request.locale) }}</span>
                    {% if produit.aVenir %}
                        <span class="produit-card__badge produit-card__badge--venir produit-card__badge--inline">{% trans %}Produit à venir{% endtrans %}</span>
                    {% endif %}
                    <h2 class="mt-2">{{ produit.nom }}</h2>
                    {% if produit.sousTitre or produit.resolution %}
                        <p class="produit-card__sous-titre fs-6">{{ produit.getTranslatedSousTitre(app.request.locale) ?: (('Caméra %res%')|trans({'%res%': produit.resolution})) }}</p>
                    {% endif %}

                    {% if produit.description %}
                        <p class="text-muted">{{ produit.getTranslatedDescription(app.request.locale) }}</p>
                    {% endif %}

                    {% if produit.avertissement %}
                        {# |raw : ce champ n'est modifiable que depuis l'admin (contenu de confiance),
                           ce qui permet d'y inclure des liens <a> vers d'autres produits. #}
                        <div class="produit-avertissement">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            {# Les liens vers d'autres produits sont saisis en admin sous la forme href="/produits/{id}"
                               (sans langue, pour rester simples à écrire) : on les recompose ici avec la langue
                               courante pour qu'ils pointent vers une URL qui existe réellement. #}
                            <span>{{ produit.getTranslatedAvertissement(app.request.locale)|replace({'href="/produits/': 'href="/' ~ app.request.locale ~ '/produits/'})|raw }}</span>
                        </div>
                    {% endif %}

                    <ul class="produit-card__specs detail-specs">
                        {% if produit.pointsForts %}
                            {% for point in produit.getTranslatedPointsFortsCompletListe(app.request.locale) %}
                                <li><i class="bi bi-check-circle-fill"></i> {{ point }}</li>
                            {% endfor %}
                        {% else %}
                            {% if produit.autonomie %}<li><i class="bi bi-check-circle-fill"></i> {{ ('Autonomie : %value%')|trans({'%value%': produit.autonomie}) }}</li>{% endif %}
                            {% if produit.stockage %}<li><i class="bi bi-check-circle-fill"></i> {{ ('Stockage : %value%')|trans({'%value%': produit.stockage}) }}</li>{% endif %}
                            <li><i class="bi bi-check-circle-fill"></i> {{ ('Alimentation : %value%')|trans({'%value%': produit.alimentation}) }}</li>
                            <li><i class="bi bi-check-circle-fill"></i> {% trans %}Application mobile incluse{% endtrans %}</li>
                        {% endif %}
                    </ul>

                    <div class="detail-prix-bloc">
                        <div class="produit-card__prix">{{ produit.prix|number_format(0, ',', ' ') }} €</div>
                        <span class="produit-card__prix-note">{% trans %}Installation + configuration incluses{% endtrans %}</span>
                    </div>

                    <a href="https://wa.me/{{ whatsapp_number }}?text={{ (('Bonjour, je souhaite installer la sonnette %nom%')|trans({'%nom%': produit.nom}))|url_encode }}"
                       target="_blank" rel="noopener" class="btn-pill btn-pill--lg">
                        {{ include('partials/_icone_whatsapp.html.twig') }}
                        {% trans %}Choisir cette offre{% endtrans %} <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            {# ==================== PRODUITS SIMILAIRES ==================== #}
            {% if produits_similaires|length > 0 %}
                <div class="section-title mt-5 pt-4">
                    <span class="section-eyebrow">{% trans %}Vous aimerez aussi{% endtrans %}</span>
                    <h2>{% trans %}Produits similaires{% endtrans %}</h2>
                </div>
                <div class="row g-4">
                    {% for autre in produits_similaires %}
                        {{ include('partials/_carte_produit.html.twig', { produit: autre }) }}
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </section>

{% endblock %}
